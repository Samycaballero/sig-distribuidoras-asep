# Plantilla de variables. Copiela como .env (en esta carpeta; .env esta en .gitignore y nunca se sube). Todas son OPCIONALES.
# Datos: SIG_DATA_DIR (defecto ../data), SIG_OUT_DIR (defecto esta carpeta). SIG_OFFLINE=1 -> sin red (usa data/raw).
SIG_OFFLINE=0
# MongoDB (defecto: localhost). MONGO_STRICT=1 falla en vez de usar el fallback JSON.
MONGO_URI=mongodb://localhost:27017
MONGO_DB=sig_distribuidoras
MONGO_STRICT=0
# IA generativa. Orden automatico: ANTHROPIC_API_KEY > GEMINI_API_KEY > OLLAMA_MODEL > Bedrock > plantilla offline.
SIG_LLM=
GEMINI_API_KEY=
GEMINI_MODEL=
OLLAMA_MODEL=
OLLAMA_HOST=http://localhost:11434
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
BEDROCK_MODEL_ID=
# Publicacion S3 (tarea publicar_s3_opcional). Sin S3_BUCKET se OMITE.
# Destino por defecto del proyecto: MinIO LOCAL (servidor S3 compatible en Docker, ver ../airflow/README.md); NO es Amazon AWS.
# Genere credenciales locales aleatorias y fuertes; nunca las suba ni las copie en logs/evidencia.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# boto3 usa estas credenciales: para MinIO, las mismas que MINIO_ROOT_USER / MINIO_ROOT_PASSWORD
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PREFIX=sig-distribuidoras-asep
# MinIO en el host: http://localhost:9100 (el contenedor de Airflow usa http://minio:9000). Vacio = Amazon S3 real.
AWS_ENDPOINT_URL=
AWS_REGION=us-east-1

# Plantilla de variables (el codigo NO lee .env: exportelas en el shell). Todas son OPCIONALES.
# Datos: SIG_DATA_DIR (defecto ../data), SIG_OUT_DIR (defecto esta carpeta). SIG_OFFLINE=1 -> sin red (usa data/raw).
SIG_OFFLINE=0
# MongoDB (defecto: localhost). MONGO_STRICT=1 falla en vez de usar el fallback JSON.
MONGO_URI=mongodb://localhost:27017
MONGO_DB=sig_distribuidoras
MONGO_STRICT=0
# IA generativa. Orden automatico: ANTHROPIC_API_KEY > GEMINI_API_KEY > OLLAMA_MODEL > Bedrock > plantilla offline.
SIG_LLM=
GEMINI_API_KEY=
GEMINI_MODEL=
OLLAMA_MODEL=
OLLAMA_HOST=http://localhost:11434
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
BEDROCK_MODEL_ID=
# Publicacion S3: requiere S3_BUCKET y credenciales AWS (cadena estandar de boto3)
S3_BUCKET=
S3_PREFIX=sig-distribuidoras-asep
AWS_REGION=us-east-1
